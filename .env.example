# ---------------------------------------------------------------------------
# Supabase（Project Settings → API）
# NEXT_PUBLIC_ が付く値はブラウザへ配信される。anon key 以外を入れないこと。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用。RLS をバイパスするため、絶対にクライアントへ渡さない。
# App Store のサーバー通知を受けて entitlement を更新するときに使う。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 認証メールのリダイレクト先。ローカルは http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# マイグレーション適用（npm run migrate）にだけ使う。アプリ本体は参照しない。
# ダッシュボードの Connect → Session pooler の URI。DB パスワードを含むので秘密。
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# App 内課金（未設定なら通知の受け口が 503 を返す。アプリは普通に動く）
# ---------------------------------------------------------------------------
# アプリの bundle identifier。通知の宛先がこのアプリかを確かめるのに使う。
APPLE_BUNDLE_ID=com.dada0707.studydash

# App Store Connect のアプリ ID（数値）。本番の検証に要る。Sandbox では空でよい。
APPLE_APP_APPLE_ID=

# "Sandbox" か "Production"。未設定なら Sandbox として扱う。
APPLE_ENVIRONMENT=Sandbox

# ---------------------------------------------------------------------------
# アプリの配布先
# ---------------------------------------------------------------------------
# App Store に公開したら URL を入れる。空のうちは紹介ページに「準備中」と出る。
NEXT_PUBLIC_APP_STORE_URL=
