# ---------------------------------------------------------------------------
# Supabase（Project Settings → API）
# NEXT_PUBLIC_ が付く値はブラウザへ配信される。anon key 以外を入れないこと。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用。RLS をバイパスするため、絶対にクライアントへ渡さない。
# Stripe Webhook での entitlement 更新とアカウント削除に使う。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 認証メールのリダイレクト先と、決済からの戻り先。ローカルは http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# マイグレーション適用（npm run migrate）にだけ使う。アプリ本体は参照しない。
# ダッシュボードの Connect → Session pooler の URI。DB パスワードを含むので秘密。
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Stripe（未設定でもアプリは動く。Proページが「準備中」になる）
# ---------------------------------------------------------------------------
# シークレットキー（sk_test_... / sk_live_...）。サーバー専用。
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Webhook の署名シークレット（whsec_...）。
# ローカルでは `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する値。
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# 商品「StudyDash Pro」に作った価格の ID（price_...）。
# 金額はコードに書かず、Stripe 側の設定を読み出して表示する。
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# ---------------------------------------------------------------------------
# 利用計測（未設定なら何も送らない。アプリは普通に動く）
# ---------------------------------------------------------------------------
# PostHog のプロジェクト API キー。設定したときだけ計測が有効になる。
NEXT_PUBLIC_POSTHOG_KEY=
# 既定は https://us.i.posthog.com。EU リージョンなら https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# フィードバックに添えるアプリの版。Vercel では VERCEL_GIT_COMMIT_SHA を渡す。
NEXT_PUBLIC_COMMIT_SHA=
